{
    "name": "vm-engine/synmod-example",
    "version": "2.0.1-dev",
    "description": "Example module demonstrating Laravel Synapse modular architecture patterns with CRUD, ACL, and filtering",
    "keywords": [
        "laravel",
        "synapse",
        "module",
        "livewire",
        "example",
        "template",
        "crud",
        "acl"
    ],
    "type": "synapse-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "theadods@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "vm-engine/synapse": "^3.2",
        "vm-engine/synapps-auth": "^3.0",
        "mews/purifier": "^3.4"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Example\\": "src/",
            "VmEngine\\Example\\Seeders\\": "database/seeders/",
            "VmEngine\\Example\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\Example\\ExampleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../synapse"
        },
        {
            "type": "path",
            "url": "../synapps-auth"
        }
    ]
}
